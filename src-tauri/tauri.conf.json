{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "yt-dlp-desktop",
  "version": "0.2.0",
  "identifier": "com.sltlala.ytdlp-desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5183",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "yt-dlp 下载器",
        "width": 1180,
        "height": 760,
        "minWidth": 940,
        "minHeight": 560,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: https: http:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'self'",
        "frame-src": "'none'",
        "form-action": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: https: http:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost ws://127.0.0.1:5183 http://127.0.0.1:5183",
        "object-src": "'none'",
        "base-uri": "'self'",
        "frame-src": "'none'",
        "form-action": "'none'"
      },
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMyRDZDOUFGRDNFQzgyQzMKUldURGd1elRyOG5Xd3JKMEE3YmJyY211RzBsZXZ5cWtHK0FHbWtyTERWQjkrVlNNdWVPRUIwUVMK",
      "endpoints": [
        "https://github.com/sltlala/yt-dlp-desktop/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/yt-dlp", "binaries/aria2c"],
    "resources": [
      "binaries/aria2c-COPYING.txt",
      "binaries/aria2c-LICENSE.OpenSSL.txt",
      "binaries/README-third-party.md"
    ]
  }
}
