{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "yt-dlp-desktop",
  "version": "0.1.0",
  "identifier": "com.sltlala.ytdlp-desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5183",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "yt-dlp 下载器",
        "width": 1180,
        "height": 760,
        "minWidth": 940,
        "minHeight": 560,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/yt-dlp", "binaries/aria2c"],
    "resources": [
      "binaries/aria2c-COPYING.txt",
      "binaries/aria2c-LICENSE.OpenSSL.txt",
      "binaries/README-third-party.md"
    ]
  }
}
